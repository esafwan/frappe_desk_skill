From 7de198ada694beb744c427b0f89fde5acbb9ac6e Mon Sep 17 00:00:00 2001
From: Saqib Ansari <nextchamp.saqib@gmail.com>
Date: Mon, 19 Oct 2026 14:31:15 +0530
Subject: [PATCH 20/27] fix(build): watchers write assets.json under a lock
 (partial backport of #44593)

The esbuild watcher and the island watchers each read, change and write assets.json. A change that rebuilt both at once, such as a pull, could drop the island's new key and leave assets.json naming a deleted file.
---
 esbuild/assets_json.js       | 58 ++++++++++++++++++++++++++++++++++++
 esbuild/assets_json.test.mjs | 54 +++++++++++++++++++++++++++++++++
 esbuild/esbuild.js           | 19 ++++++++----
 ui/vite/island/assets.js     | 43 ++++++++++----------------
 4 files changed, 141 insertions(+), 33 deletions(-)
 create mode 100644 esbuild/assets_json.js
 create mode 100644 esbuild/assets_json.test.mjs

diff --git a/esbuild/assets_json.js b/esbuild/assets_json.js
new file mode 100644
index 000000000000..856485bc8ef2
--- /dev/null
+++ b/esbuild/assets_json.js
@@ -0,0 +1,58 @@
+const fs = require("fs");
+
+// a writer that died holding the lock frees it after this long
+const STALE_LOCK_MS = 10000;
+const RETRY_MS = 20;
+
+/**
+ * Read, change and write an assets.json under a lock.
+ *
+ * The esbuild watcher and each island watcher rewrite one assets.json, and a
+ * write that lands between another's read and write drops that writer's keys.
+ * `update` takes the parsed file and returns the whole new object.
+ *
+ * @returns {Promise<{ previous: Object, next: Object }>}
+ */
+async function update_assets_json(assets_json_path, update) {
+	const lock = assets_json_path + ".lock";
+	await acquire(lock);
+	try {
+		const previous = read(assets_json_path);
+		const next = update(previous);
+		fs.writeFileSync(assets_json_path, JSON.stringify(next, null, 4));
+		return { previous, next };
+	} finally {
+		fs.rmSync(lock, { recursive: true, force: true });
+	}
+}
+
+async function acquire(lock) {
+	for (;;) {
+		try {
+			fs.mkdirSync(lock);
+			return;
+		} catch (error) {
+			if (error.code !== "EEXIST") throw error;
+		}
+		if (is_stale(lock)) fs.rmSync(lock, { recursive: true, force: true });
+		await new Promise((resolve) => setTimeout(resolve, RETRY_MS));
+	}
+}
+
+function is_stale(lock) {
+	try {
+		return Date.now() - fs.statSync(lock).mtimeMs > STALE_LOCK_MS;
+	} catch {
+		return false;
+	}
+}
+
+function read(assets_json_path) {
+	try {
+		return JSON.parse(fs.readFileSync(assets_json_path, "utf-8"));
+	} catch {
+		return {};
+	}
+}
+
+module.exports = { update_assets_json };
