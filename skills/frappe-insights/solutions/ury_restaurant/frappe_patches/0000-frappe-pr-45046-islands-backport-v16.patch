From 25027e53fc469a4c837c682ec51db2ba6ba7ebb6 Mon Sep 17 00:00:00 2001
From: Saqib Ansari <nextchamp.saqib@gmail.com>
Date: Sun, 1 Nov 2026 12:54:22 +0000
Subject: [PATCH 26/27] fix(desk): show each island action's icon in the
 dashboard menu

---
 frappe/core/page/dashboard_view/dashboard_view.js | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/frappe/core/page/dashboard_view/dashboard_view.js b/frappe/core/page/dashboard_view/dashboard_view.js
index 0c50703246c8..f4637de98db9 100644
--- a/frappe/core/page/dashboard_view/dashboard_view.js
+++ b/frappe/core/page/dashboard_view/dashboard_view.js
@@ -211,9 +211,9 @@ frappe.pages["dashboard-view"].on_page_load = function (wrapper) {
 
 	/**
 	 * An `Action` is `{ label, icon? }` plus either `onClick` or `href`. An `href`
-	 * leads out of the app, and desk opens it in a new tab. Desk's menu rows carry
-	 * no icon, so the icon goes unread. It names a lucide icon the island ships,
-	 * and desk resolves a name against its own sprite.
+	 * leads out of the app, and desk opens it in a new tab. The icon names a lucide
+	 * icon the island ships, and desk resolves a name against its own sprite. A name
+	 * the sprite lacks draws an empty box, so that row goes without an icon.
 	 *
 	 * A desk menu row is a click handler, not a link, because `add_dropdown_item`
 	 * writes `href="#"` itself. So the new tab is `window.open`, not a `target`.
@@ -224,7 +224,14 @@ frappe.pages["dashboard-view"].on_page_load = function (wrapper) {
 		page.clear_menu();
 		(actions || []).forEach((action) => {
 			const click = action.href ? () => window.open(action.href, "_blank") : action.onClick;
-			page.add_menu_item(frappe.utils.escape_html(action.label), click);
+			const icon =
+				action.icon && document.getElementById(`icon-${action.icon}`) ? action.icon : null;
+			page.add_dropdown_item({
+				label: frappe.utils.escape_html(action.label),
+				click,
+				parent: page.menu,
+				icon,
+			});
 		});
 	}
 

From b0063e5a6d4c002d8ab72bfc40f939c4147d57e8 Mon Sep 17 00:00:00 2001
From: Saqib Ansari <nextchamp.saqib@gmail.com>
Date: Mon, 19 Oct 2026 19:11:37 +0530
Subject: [PATCH 27/27] fix(build): an unreadable assets.json fails the build
 instead of being overwritten

Only a missing file starts empty, as esbuild's own reader did before the lock.

(cherry picked from commit b3721ed697ea14c84930af3a358d3ebc6bfb82ca)
---
 esbuild/assets_json.js       |  9 ++++++---
 esbuild/assets_json.test.mjs | 19 +++++++++++++++++++
 2 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/esbuild/assets_json.js b/esbuild/assets_json.js
index 856485bc8ef2..f0d167fb6b90 100644
--- a/esbuild/assets_json.js
+++ b/esbuild/assets_json.js
@@ -48,11 +48,14 @@ function is_stale(lock) {
 }
 
 function read(assets_json_path) {
+	let contents;
 	try {
-		return JSON.parse(fs.readFileSync(assets_json_path, "utf-8"));
-	} catch {
-		return {};
+		contents = fs.readFileSync(assets_json_path, "utf-8");
+	} catch (error) {
+		if (error.code === "ENOENT") return {};
+		throw error;
 	}
+	return JSON.parse(contents);
 }
 
 module.exports = { update_assets_json };
diff --git a/esbuild/assets_json.test.mjs b/esbuild/assets_json.test.mjs
index fce5a0b94f1f..c10f67d7eff3 100644
--- a/esbuild/assets_json.test.mjs
+++ b/esbuild/assets_json.test.mjs
@@ -52,3 +52,22 @@ test("a failed update frees the lock", async () => {
   );
   assert.equal(fs.existsSync(file + ".lock"), false);
 });
+
+test("a missing file starts empty, and an unreadable one is left as it is", async () => {
+  const file = path.join(
+    fs.mkdtempSync(path.join(os.tmpdir(), "assets-json-")),
+    "assets.json"
+  );
+  const { previous } = await update_assets_json(file, () => ({
+    "a.js": "a.1.js",
+  }));
+  assert.deepEqual(previous, {});
+
+  fs.writeFileSync(file, "{");
+  await assert.rejects(
+    update_assets_json(file, () => ({})),
+    SyntaxError
+  );
+  assert.equal(fs.readFileSync(file, "utf-8"), "{");
+  assert.equal(fs.existsSync(file + ".lock"), false);
+});
