From ccad86ac097d60b39969be6bf73406bd90368826 Mon Sep 17 00:00:00 2001
From: Saqib Ansari <nextchamp.saqib@gmail.com>
Date: Tue, 20 Oct 2026 01:41:38 +0530
Subject: [PATCH 01/27] fix(build): LTR styles no longer pick up the RTL
 build's output on a symlinked app

The postcss plugin places each entry's temp file by its path relative to the cwd's parent. A symlinked app's cwd is its real path, so the temp path left the build's own temp dir, and the parallel LTR and RTL builds wrote the same file. Desk shipped body { text-align: right }.
---
 esbuild/esbuild.js | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/esbuild/esbuild.js b/esbuild/esbuild.js
index 1ceafe6ac904..ad52c832c762 100644
--- a/esbuild/esbuild.js
+++ b/esbuild/esbuild.js
@@ -307,6 +307,11 @@ function build_style_files({ files, outdir, rtl_style = false }) {
 		postCssPlugin({
 			plugins: plugins,
 			sassOptions: sass_options,
+			// The plugin writes each entry to its temp dir at the entry's path relative to
+			// rootDir's parent. Its default, the cwd, is the app's real path. When the app is
+			// a symlink, that path climbs out of the temp dir, and the LTR and RTL builds
+			// write the same file.
+			rootDir: path.resolve(apps_path, "frappe"),
 		}),
 	];
 

